# Copy to .env and fill in. Never commit .env.

# --- Service ---
APP_PORT=8000
LOG_LEVEL=info

# --- Database ---
# 5433 = host port in docker-compose.yml; inside compose the api uses db:5432.
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5433/nimbus

# --- LLM provider (Groq via ChatGroq, like the reference repo) ---
# provider: groq | stub (deterministic, no key) ; local/CI runs stay on stub.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=
LLM_TIMEOUT_S=3.5
LLM_MAX_CALLS=2

# --- Embeddings (local open model; used from Phase 1 KB ingestion) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Agent guards / business rules (no hard-coded thresholds) ---
AGENT_TOKEN=               # shared token for agent-dashboard routes
STEP_LIMIT=8               # max tool/LLM steps per run
TOOL_TIMEOUT_S=8           # per-tool timeout
REFUND_WINDOW_DAYS=30      # refund eligibility window
